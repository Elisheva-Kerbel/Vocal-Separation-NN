# Project
APP_ENV=local

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Frontend
FRONTEND_PORT=5173
VITE_API_BASE_URL=http://localhost:8000

# PostgreSQL
POSTGRES_DB=stemspace
POSTGRES_USER=stemspace
POSTGRES_PASSWORD=change_me_local_only
DATABASE_URL=postgresql+psycopg://stemspace:change_me_local_only@postgres:5432/stemspace

# Redis / Celery
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# MinIO local dev placeholders only
MINIO_ROOT_USER=minio_local_user
MINIO_ROOT_PASSWORD=change_me_local_only
S3_ENDPOINT_URL=http://minio:9000
S3_BUCKET=stemspace-local-private
S3_ACCESS_KEY_ID=minio_local_user
S3_SECRET_ACCESS_KEY=change_me_local_only
S3_REGION=us-east-1

# Local Basic model prototype (P1-004B / DEC-0004) — LOCAL / OUT-OF-BAND ONLY.
# Point LOCAL_MODEL_ROOT at your local model folder OUTSIDE the repo (it must
# contain checkpoints/best_model.pt). Left BLANK here on purpose: never commit a
# real machine path, and never commit checkpoint/model weights. Set it only in
# your local, git-ignored .env. Consumed by the local prototype adapter (used in
# the future P1-004C validation run); the app itself does not require it.
LOCAL_MODEL_ROOT=
# Optional local-benchmark-only checkpoint slot selector (true -> best_model.pt;
# false -> the temporary basic slot). Not a Professional tier.
LOCAL_MODEL_USE_BEST=true
