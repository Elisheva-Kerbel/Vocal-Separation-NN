# Project
APP_ENV=local

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Frontend
FRONTEND_PORT=5173
VITE_API_BASE_URL=http://localhost:8000

# PostgreSQL
POSTGRES_DB=stemspace
POSTGRES_USER=stemspace
POSTGRES_PASSWORD=change_me_local_only
DATABASE_URL=postgresql+psycopg://stemspace:change_me_local_only@postgres:5432/stemspace

# Redis / Celery
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# MinIO local dev placeholders only
MINIO_ROOT_USER=minio_local_user
MINIO_ROOT_PASSWORD=change_me_local_only
S3_ENDPOINT_URL=http://minio:9000
S3_BUCKET=stemspace-local-private
S3_ACCESS_KEY_ID=minio_local_user
S3_SECRET_ACCESS_KEY=change_me_local_only
S3_REGION=us-east-1

# Local Basic model prototype (P1-004B / DEC-0004) — LOCAL / OUT-OF-BAND ONLY.
#
# LOCAL_MODEL_HOST_ROOT is the HOST folder holding the local model.
# Leave empty to use the bundled model in ./models/
LOCAL_MODEL_HOST_ROOT=
# CONTAINER-side model root — the read-only mount point, not a host path. This
# is what the local prototype adapter / benchmark CLI reads.
LOCAL_MODEL_ROOT=/models
# Optional local-benchmark-only checkpoint slot selector (true -> best_model.pt;
# false -> the temporary basic slot). Not a Professional tier.
LOCAL_MODEL_USE_BEST=true
# Reserved container-side directory for local demo artifacts.
DEMO_DATA_DIR=/app/local-data/demo

# Quota
FREE_DAILY_LIMIT=3
PRO_DAILY_LIMIT=10

# Upload
MAX_UPLOAD_BYTES=104857600
MAX_DURATION_SECONDS=330

# Signed URL TTL (seconds)
SIGNED_URL_LISTEN_TTL=600
SIGNED_URL_DOWNLOAD_TTL=300

# MinIO public endpoint (browser-facing URL for presigned URLs)
S3_PUBLIC_ENDPOINT_URL=http://localhost:9000

# Email (SMTP) — for email notifications
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=VocalSplit

# Google OAuth (optional)
GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=
